# Copy to .env and fill in. .env is gitignored and must never be committed.
#
#   cp .env.example .env
#
# Every key below is also a field on trace_ai.config.Settings; a test asserts
# the two stay in sync, so add new settings to both.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
APP_ENV=local
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Model providers
# ---------------------------------------------------------------------------
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
