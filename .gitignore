# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Tool caches
.ruff_cache/
.mypy_cache/
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# macOS Finder metadata. Written into any directory the platform browses, including
# tracked fixture trees under demo/ and benchmarks/; unanchored so it is caught wherever
# it appears rather than at the root alone.
.DS_Store

# Secrets
.env
.env.*
!.env.example

# Staged issue bodies produced by scripts/seed_backlog.py
scripts/.staged/

# The local artifact store. Nothing writes it yet. The loader is designed to put ingested
# source documents, normalized text, generated reports, and traces here, and those are
# copies of material under review -- including the deliberate prompt-injection fixture.
# The rule lands before the writer so the first run cannot offer them to a commit.
#
# Anchored to the repository root. demo/, benchmarks/, and requirements/ hold
# version-controlled fixtures; an unanchored rule would silently swallow a data/
# directory under any of them.
/data/

# The harness's metrics feed (DEC-073): derived from the assessment stores, keyed by scenario,
# condition, and label, and regenerable by one command. DEC-073 left the tree's location open;
# it lives in-repo for the scorecard and CI to read, and out of history because a derived
# artifact that regenerates on demand earns no place there.
/benchmarks/results/

# The rendered documentation site (DEC-104): mkdocs builds docs/ into site/, locally and in CI.
# The Pages deploy consumes it as a workflow artifact, so the rendering never enters history;
# the Markdown sources under docs/ are the authoritative copies.
/site/

# Claude Code agent worktrees (session-local)
.claude/worktrees/
